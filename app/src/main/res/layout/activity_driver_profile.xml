<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Profile"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/inputFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/inputAadhar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Aadhar Number"
            android:inputType="number"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/inputPan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PAN Number"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/inputVoterId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Voter ID Number"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/inputLicense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Driving License Number"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnUploadDocs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload Documents"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnSubmitProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit for Verification"/>
    </LinearLayout>
</ScrollView>
