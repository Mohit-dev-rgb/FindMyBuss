<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.findmybus">

    <application
        android:allowBackup="true"
        android:label="Find My Bus"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.FindMyBus">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity android:name=".PassengerLoginActivity" />
        <activity android:name=".DriverProfileActivity" />
        <activity android:name=".PassengerHomeActivity" />
        <activity android:name=".MapActivity" />

    </application>

</manifest>
